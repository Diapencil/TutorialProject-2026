  m_Script: {fileID: 11500000, guid: 76e52d79f05fec84da88b585a329c43e, type: 3}
  m_Name: Tutorial
  m_EditorClassIdentifier: Assembly-CSharp::SheepSheepBurger.Core.Dialogue
  orderLines:
  - "\uD558\uD558\uD558! \uB4DC\uB514\uC5B4 \uD584\uBC84\uAC70 \uAC00\uAC8C\uAC00
    \uBB38\uC744 \uC5F4\uC5C8\uAD70. \uD584\uBC84\uAC70 \uD558\uB098 \uC8FC\uBB38\uD558\uC9C0."
  hintLine: "\uC5B4\uB514 \uD55C\uBC88 \uD584\uBC84\uAC70 \uD558\uB098\uB294 \uC81C\uB300\uB85C
    \uB9CC\uB4E4 \uC218 \uC788\uB294\uC9C0 \uBCF4\uC790\uACE0. \uAD6C\uC6B4 \uD328\uD2F0\uC5D0
    \uCE58\uC988\uC640 \uD53C\uD074\uC744 \uB123\uC5B4\uC11C \uB9D0\uC774\uC9C0.
    \uCF00\uCCA9\uACFC \uBA38\uC2A4\uD0C0\uB4DC\uB97C \uBE7C\uBA39\uC73C\uBA74 \uC548\uB41C\uB2E4\uB294
    \uAC74 \uC798 \uC54C\uACE0 \uC788\uACA0\uC9C0? "
  perfectLine: "\uC644\uBCBD\uD558\uAD70. \uC694\uB9AC \uC2E4\uB825\uC740 \uC788\uAD70
    \uADF8\uB798. \uD55C \uBC88 \uC5F4\uC2EC\uD788 \uD574\uBCF4\uB77C\uACE0. \uC9C0\uCF1C\uBCF4\uACE0
    \uC788\uC744\uD14C\uB2C8 \uB9D0\uC774\uC57C."
  normalLine: "\uBB50, \uC7A5\uC0AC \uC811\uC744 \uC815\uB3C4\uB294 \uC544\uB2C8\uAD6C\uB9CC.
    \uD55C \uBC88 \uC5F4\uC2EC\uD788 \uD574\uBCF4\uB77C\uACE0. \uC9C0\uCF1C\uBCF4\uACE0
    \uC788\uC744\uD14C\uB2C8 \uB9D0\uC774\uC57C. "
  badLine: "\uC2E4\uB825\uC774 \uC544\uC8FC \uD615\uD3B8\uC5C6\uAD70. \uD558\uD558\uD558!
    \uD55C \uBC88 \uC5F4\uC2EC\uD788 \uD574\uBCF4\uB77C\uACE0. \uC9C0\uCF1C\uBCF4\uACE0
    \uC788\uC744\uD14C\uB2C8 \uB9D0\uC774\uC57C."
